:80 {
	root * /usr/share/caddy
	encode gzip zstd
	try_files {path} {path}/ /index.html
	file_server
	header {
		Cache-Control "public, max-age=300"
		-Server
		# Security headers moved into git (2026-08-30). These are byte-identical
		# to the set that ran hand-patched in the live container since
		# 2026-08-19 (docker-exec edit, wiped on every redeploy — the
		# familyfinance failure class). CSP tightened 2026-10-02 (t853 redesign):
		# fonts are self-hosted now, so the Google Fonts allowances are gone.
		Strict-Transport-Security "max-age=15768000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:;"
	}
}
